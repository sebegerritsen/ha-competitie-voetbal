{
  "config": {
    "step": {
      "user": {
        "title": "Log in with your voetbal.nl account",
        "description": "The account you use in the voetbal.nl app. A free spectator or parent account is enough. Your password is used once and not stored.",
        "data": {
          "email": "Email",
          "password": "Password"
        }
      },
      "favorites": {
        "title": "Teams you follow",
        "description": "These are the teams this account follows in the voetbal.nl app. You can add any other team later with **Add team**.",
        "data": {
          "teams": "Teams"
        }
      },
      "reauth_confirm": {
        "title": "Log in again",
        "description": "The voetbal.nl session of {email} has ended. Enter the password to continue.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Wrong email address or password.",
      "cannot_connect": "Could not reach voetbal.nl. Try again later."
    },
    "abort": {
      "already_configured": "This account is already set up.",
      "reauth_successful": "Logged in again."
    }
  },
  "config_subentries": {
    "team": {
      "initiate_flow": {
        "user": "Add team",
        "reconfigure": "Settings"
      },
      "entry_type": "Team",
      "step": {
        "user": {
          "title": "Add a team",
          "menu_options": {
            "favorite": "A team you follow",
            "search": "Search a club"
          }
        },
        "favorite": {
          "title": "Teams you follow",
          "data": {
            "team_id": "Team"
          }
        },
        "search": {
          "title": "Find the club",
          "data": {
            "query": "Club name or town"
          },
          "data_description": {
            "query": "For example part of the club's name, or its town."
          }
        },
        "club": {
          "title": "Pick the club",
          "data": {
            "club_id": "Club"
          }
        },
        "team": {
          "title": "Pick the team",
          "description": "Teams of {club}.",
          "data": {
            "team_id": "Team"
          }
        },
        "reconfigure": {
          "title": "Settings of {team}",
          "description": "The meet time is the club's departure time (vertrektijd) when the club entered one; otherwise kick-off minus these minutes.",
          "data": {
            "meet_minutes_home": "Meet before a home match",
            "meet_minutes_away": "Meet before an away match",
            "weather_entity": "Weather for the forecast at kick-off"
          },
          "data_description": {
            "weather_entity": "Optional. Adds a *Weather at next match* sensor, from 48 hours before."
          }
        }
      },
      "error": {
        "cannot_connect": "Could not reach voetbal.nl. Try again later.",
        "no_clubs_found": "No club found. Try a shorter part of the name, or the town."
      },
      "abort": {
        "already_configured": "This team is already set up.",
        "no_teams": "{club} has no teams at the moment.",
        "account_not_loaded": "The account is not working at the moment (see its status). Fix that first.",
        "reconfigure_successful": "Settings saved."
      }
    },
    "club": {
      "initiate_flow": {
        "user": "Add club"
      },
      "entry_type": "Club",
      "step": {
        "search": {
          "title": "Follow a club",
          "description": "Every match of every team of the club: a calendar, today's (home) matches and the latest results.",
          "data": {
            "query": "Club name or town"
          },
          "data_description": {
            "query": "For example part of the club's name, or its town."
          }
        },
        "club": {
          "title": "Pick the club",
          "data": {
            "club_id": "Club"
          }
        }
      },
      "error": {
        "cannot_connect": "Could not reach voetbal.nl. Try again later.",
        "no_clubs_found": "No club found. Try a shorter part of the name, or the town."
      },
      "abort": {
        "already_configured": "This club is already followed.",
        "account_not_loaded": "The account is not working at the moment (see its status). Fix that first.",
        "no_settings": "A club has no settings."
      }
    }
  },
