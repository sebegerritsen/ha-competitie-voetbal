  "issues": {
    "api_changed": {
      "title": "Competitie Voetbal needs an update",
      "description": "The voetbal.nl app's data service no longer accepts the requests of this version of the integration (the app was updated). Update Competitie Voetbal in HACS; if there is no newer version yet, please report it in the issues."
    }
  },
  "services": {
    "get_matches": {
      "name": "Get matches",
      "description": "Returns the matches of a team (with venue, meet time, score) or of a club.",
      "fields": {
        "device_id": {
          "name": "Team or club",
          "description": "The team's or club's device."
        },
        "upcoming_only": {
